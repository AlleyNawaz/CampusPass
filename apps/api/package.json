    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@campuspass/contracts": "file:../../packages/contracts",
    "@campuspass/domain": "file:../../packages/domain",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/client": "6.12.0",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/node": "26.6.5",
    "prisma": "6.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
