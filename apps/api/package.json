{
  "name": "@campuspass/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
