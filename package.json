{
  "name": "campuspass",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:db:start": "node scripts/dev-db.mjs start",
    "dev:db:stop": "node scripts/dev-db.mjs stop",
    "dev:db:status": "node scripts/dev-db.mjs status",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check .",
    "db:generate": "npm run prisma:generate --workspace @campuspass/api",
    "db:migrate": "npm run prisma:migrate --workspace @campuspass/api",
    "db:seed": "npm run prisma:seed --workspace @campuspass/api",
    "test:security:http": "node tests/security/api-security.integration.mjs",
    "test:security:static": "node tests/security/static-security.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
