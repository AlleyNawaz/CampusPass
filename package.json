{
  "name": "campuspass",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check .",
    "db:generate": "npm run prisma:generate --workspace @campuspass/api",
    "db:migrate": "npm run prisma:migrate --workspace @campuspass/api",
    "db:seed": "npm run prisma:seed --workspace @campuspass/api"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
