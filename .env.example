NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
POSTGRES_DB=campuspass
POSTGRES_USER=campuspass
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://campuspass:SET_A_LOCAL_RANDOM_PASSWORD@localhost:5432/campuspass?schema=public
PUBLIC_WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
PAID_TICKETS_ENABLED=false
OFFLINE_SCANNING_ENABLED=false
EMAIL_PROVIDER=console-disabled
PAYMENT_PROVIDER=disabled
# Generate unique values locally. Production values must come from a secret manager.
TICKET_CREDENTIAL_ENCRYPTION_KEY_BASE64=
AUTH_PASSWORD_PEPPER=
AUTH_MFA_ENCRYPTION_KEY_BASE64=
DATABASE_APP_ROLE=campuspass_app
TRUST_PROXY=false
API_BODY_LIMIT_BYTES=65536
SEED_STUDENT_PASSWORD=
SEED_SCANNER_PASSWORD=
